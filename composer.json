{
    "name": "clockwork-wp/offloader-lite",
    "description": "WordPress plugin for offloading media to S3",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "aws/aws-sdk-php": "^3.0",
        "symfony/filesystem": "^7.4.0"
    },
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ClockworkOffloader\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "test:unit": "./vendor/bin/phpunit --testsuite Unit"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "brain/monkey": "^2.7",
        "mockery/mockery": "^1.6"
    }
}
